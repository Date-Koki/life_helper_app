<div class="living-todos-container">

  <h1>💡提案</h1>

  <div class="todo-suggestion">
    <p>作成した方がいい新生活TODOリストの提案です👇</p>

    <%= form_with url: bulk_create_living_todos_path, method: :post do %>

      <% @todos.each_with_index do |(category, todos), i| %>
        <h3><%= category %></h3>

        <% todos.each_with_index do |todo, j| %>
          <div class="todo-item">

            <label>
              <%= check_box_tag "todos[#{i}_#{j}][checked]", "1" %>
              <%= todo %>
            </label><br>

            <%= hidden_field_tag "todos[#{i}_#{j}][title]", "#{category}|#{todo}" %>

            <%= text_field_tag "todos[#{i}_#{j}][description]", "", placeholder: "やることの説明を入力" %>

            <%= datetime_local_field_tag "todos[#{i}_#{j}][schedule_at]" %>
          </div>
        <% end %>

      <% end %>

      <%= submit_tag "選択したTODOを追加", class: "btn btn-primary" %>

    <% end %>

  </div>

  <h3>自治体リンク</h3>

  <% if @links.present? %>
    <ul>
      <% @links.each do |name, url| %>
        <li>
          <a href="<%= url %>" target="_blank">
            <%= name %>
          </a>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>該当する自治体情報がありません</p>
  <% end %>

  <%= link_to "戻る", new_living_todo_path, class: "nav-btn" %>
</div>