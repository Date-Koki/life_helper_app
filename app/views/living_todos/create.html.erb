<div class="living-todos-container">

  <h1>💡提案</h1>

  <div class="ai-bubble">
    <p>作成した方がいい新生活TODOリストの提案です👇</p>
    <% @todos.each do |category, todos| %>
      <h3><%= category %></h3>
      <ul>
        <% todos.each do |todo| %>
          <li><%= todo %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%= link_to "戻る", new_living_todo_path, class: "nav-btn" %>
</div>