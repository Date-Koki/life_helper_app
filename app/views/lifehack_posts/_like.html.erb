<% like = lifehack_post.likes.find_by(user: current_user) %>

<div id="like-button-<%= lifehack_post.id %>">
  <% if like %>
    <%= link_to "❤️ いいね済",
          lifehack_post_like_path(lifehack_post, like),
          method: :delete,
          class: "like-btn liked no-underline" %>
  <% else %>
    <%= link_to "🤍 いいね",
          lifehack_post_likes_path(lifehack_post),
          method: :post,
          class: "like-btn no-underline" %>
  <% end %>
</div>