<h2 class="posts-title">TODOリスト投稿一覧</h2>

<% if @posts.any? %>
  <div class="posts-grid">
    <% @posts.each do |post| %>
      <div class="post-card">
        <div class="post-card-body">
          <h3 class="post-title"><%= post.title %></h3>
          <p class="post-meta">
            📂 <%= post.category&.name %><br>
          </p>
          <p class="post-description"><%= truncate(post.description, length: 60) %></p>
          <%= link_to "詳細を見る", post_path(post), class: "post-btn" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>TODO投稿はまだありません。</p>
<% end %>

<hr>

<h2 class="posts-title">ライフハック投稿一覧</h2>

<!-- ライフハック検索フォーム -->
<div class="search-form">
  <%= search_form_for @q, url: root_path, method: :get do |f| %>
    <div class="search-field">
      <%= f.label :description_cont, "検索ワード" %>
      <%= f.search_field :description_cont %>
    </div>
    <div class="search-field">
      <%= f.label :category_id_eq, "カテゴリー" %>
      <%= f.collection_select :category_id_eq, Category.all, :id, :name, include_blank: "すべて" %>
    </div>
    <%= f.submit "検索", class: "search-btn" %>
  <% end %>
</div>

<% if @lifehack_posts.any? %>
  <div class="posts-grid">
    <% @lifehack_posts.each do |post| %>
      <div class="post-card">
        <div class="post-card-body">
          <h3 class="post-title"><%= post.title %></h3>
          <p class="post-meta">
            📂 <%= post.category&.name || "カテゴリなし" %><br>
            <% if post.image.attached? %>
              <%= image_tag post.image.variant(resize: '200x200'), class: 'post-image' %>
            <% end %>
          </p>
          <p class="post-description"><%= truncate(post.description, length: 60) %></p>
          <%= link_to "詳細を見る", lifehack_post_path(post), class: "post-btn" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>ライフハック投稿はまだありません。</p>
<% end %>