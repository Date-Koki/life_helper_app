<h2 class="posts-title">✏️TODOリスト投稿一覧</h2>

<div class="progress-bar">
  <div class="progress" style="width: <%= @completion_rate %>%;">
  </div>
</div>
<p><%= @completion_rate %>% 完了</p>

<% if user_signed_in? %>

  <h3>⚠ 期限が近いタスク</h3>

  <% if @near_posts.any? %>
    <ul>
      <% @near_posts.each do |post| %>
        <li>
          <%= post.title %>（<%= post.schedule_at.strftime("%m/%d") %>）
        </li>
      <% end %>
    </ul>
  <% end %>

  <div class="todo-filter">
    <%= link_to "すべて", root_path, class: "filter-btn" %>
    <%= link_to "完了", root_path(status: "completed"), class: "filter-btn" %>
    <%= link_to "未完了", root_path(status: "incomplete"), class: "filter-btn" %>
  </div>

  <div class="todo-sort">
    <%= link_to "新しい順", root_path(sort: "new"), class: "sort-btn" %>
    <%= link_to "古い順", root_path(sort: "old"), class: "sort-btn" %>
    <%= link_to "期限順", root_path(sort: "deadline"), class: "sort-btn" %>
  </div>

  <% if @posts.any? %>
    <div class="posts-grid">
      <% @posts.each do |post| %>
        <div class="post-card <%= 'expired' if post.schedule_at < Time.current %>">
          <div class="post-card-body">
            <h3 class="post-title"><%= post.title %></h3>
            <p class="post-meta">
              📂 <%= post.category&.name %><br>
              📅 <%= post.schedule_at.strftime("%Y年%m月%d日 %H:%M") %><br>
            </p>
            <p class="post-description"><%= truncate(post.description, length: 60) %></p>
            <%= link_to "詳細を見る", post_path(post), class: "post-btn" %>
            <%= button_to toggle_complete_post_path(post),
              method: :patch,
              class: "complete-btn" do %>

              <% if post.completed? %>
                ↩ 未完了に戻す
              <% else %>
                ✔ 完了
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <p>TODO投稿はまだありません。</p>
  <% end %>

<% else %>
  <p>TODOを作成するには、ログインしてください。</p>
<% end %>

<h2 class="posts-title">✏️ライフハック投稿一覧</h2>

<div class="search-form">
  <%= search_form_for @q, url: root_path, method: :get do |f| %>
    <div class="search-field">
      <%= f.label :description_cont, "検索ワード" %>
      <%= f.search_field :description_cont %>
    </div>
    <div class="search-field">
      <%= f.label :category_id_eq, "カテゴリー" %>
      <%= f.collection_select :category_id_eq, Category.all, :id, :name, include_blank: "すべて" %>
    </div>
    <%= f.submit "検索", class: "search-btn" %>
  <% end %>
</div>

<% if @lifehack_posts.any? %>
  <div class="posts-grid">
    <% @lifehack_posts.each do |post| %>
      <div class="post-card">
        <div class="post-card-body">
          <h3 class="post-title"><%= post.title %></h3>
          <p class="post-meta">
            📂 <%= post.category&.name || "カテゴリなし" %><br>
            <% if post.image.attached? %>
              <%= image_tag post.image.variant(resize: '200x200'), class: 'post-image' %>
            <% end %>
          </p>
          <p class="post-description"><%= truncate(post.description, length: 60) %></p>
          <%= link_to "詳細を見る", lifehack_post_path(post), class: "post-btn" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>ライフハック投稿はまだありません。</p>
<% end %>